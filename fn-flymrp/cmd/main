#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
GATEWAY_PREFIX="/app/flymrp"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

status_app() {
  # 只判进程存活，不检查 socket（避免系统在启动中途探测 status 误判失败）
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "${PID_FILE}"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  # 清理残留，防 EADDRINUSE / 误判
  pkill -f "${APP_DIR}/server.js" >/dev/null 2>&1
  rm -f "${SOCKET_PATH}" "${PID_FILE}" 2>/dev/null

  log_msg "Starting flymrp server..."
  cd "${APP_DIR}" || { echo "找不到 ${APP_DIR}" > "${TRIM_TEMP_LOGFILE}"; return 1; }

  DATA_DIR="${DATA_DIR}" \
  GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
  SOCKET_PATH="${SOCKET_PATH}" \
  VMRP_DISABLE_TCP="1" \
    node server.js >> "${LOG_FILE}" 2>&1 &
  echo "$!" > "${PID_FILE}"

  # 等待网关 socket 真正出现，超时报错
  wait_count=0
  while [ ! -S "${SOCKET_PATH}" ] && [ "${wait_count}" -lt 20 ]; do
    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if ! check_process "${pid}"; then
      echo "服务启动失败: 进程提前退出, 请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
      rm -f "${PID_FILE}"
      return 1
    fi
    sleep 0.5
    wait_count=$((wait_count + 1))
  done

  if [ ! -S "${SOCKET_PATH}" ]; then
    echo "等待网关 socket 超时, 请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
    rm -f "${PID_FILE}"
    return 1
  fi

  log_msg "flymrp server started (pid $(head -n 1 "${PID_FILE}"))"
  return 0
}

stop_app() {
  log_msg "Stopping flymrp server..."

  if [ ! -f "${PID_FILE}" ]; then
    rm -f "${SOCKET_PATH}" 2>/dev/null
    return 0
  fi

  local pid
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"

  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "${PID_FILE}" "${SOCKET_PATH}" 2>/dev/null
    return 0
  fi

  kill -TERM "$pid" 2>> "${LOG_FILE}" || true

  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "${LOG_FILE}" || true
  fi

  rm -f "${PID_FILE}" "${SOCKET_PATH}" 2>/dev/null
  log_msg "flymrp server stopped"
  return 0
}

case "$1" in
  start)
    if start_app; then exit 0; else exit 1; fi
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
